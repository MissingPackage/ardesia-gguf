vendor/
outputs/
__pycache__/
*.py[cod]

# secrets — never commit (see ardesia-unsloth CLAUDE.md)
.env

# heavy artifacts — never in git
models/
artifacts/
eval_out/
*.gguf
*.safetensors
*.bin

# scratch
/tmp/
*.log
# generata a runtime da unsloth nella cwd
unsloth_compiled_cache/
